#include <stdio.h>
import hal::Uart;
import PosixHal;

/* Run with fd 0 and fd 1 closed: send and recv must report -1, not crash. */
int main(void)
{
    Uart u = posix_hal;
    char buf[4];
    int a = u.send("x", 1);
    int b = u.recv(buf, 1);

    fprintf(stderr, "send_err=%d recv_err=%d\n", a == -1, b == -1);
    if (a != -1) return 1;
    if (b != -1) return 2;
    return 0;
}
