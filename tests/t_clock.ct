#include <stdio.h>
import hal::Clock;
import PosixHal;

int main(void)
{
    int t0 = hal::Clock.nowMs();
    int t1 = hal::Clock.nowMs();
    int t2 = hal::Clock.nowMs();

    printf("t0=%d monotonic=%d\n", t0, t0 <= t1 && t1 <= t2);
    if (t0 != 0) return 1;
    if (t0 > t1 || t1 > t2) return 2;
    return 0;
}
