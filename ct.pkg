# hal-posix - the POSIX platform half of the hal contract (Wave 1).
#
# One source tree for macOS and Linux (x86_64 / aarch64): the implementation
# only uses POSIX calls, so there is no #ifdef and no per-platform copy.
#
# `-std=c99` (what `ct build` passes) hides the POSIX declarations in glibc
# (`read`, `write`, `clock_gettime`) unless the feature level is asked for, so
# the package carries it in `cflags` instead of a source `#define`.
name = hal-posix
version = 0.1.0
dep = hal@^0.1.0
licence = MIT
cflags = -D_POSIX_C_SOURCE=200809L
