/*
 * PosixHal.h.ct - the POSIX implementation of the hal contract.
 *
 * One unit carries the platform functions, one public instance and the three
 * instance maps that bind Uart / Gpio / Log to those functions. Everything is
 * POSIX (`write` / `read` / `clock_gettime`), so the same source serves macOS
 * and Linux on x86_64 and aarch64 with no #ifdef.
 *
 * Uart: send writes fd 1 (stdout), recv reads fd 0 (stdin) - the console
 * stands in for the serial line. Gpio: a 32-pin in-memory stub (one bit per
 * pin), not real hardware. Log: fd 2 (stderr).
 *
 * Clock is not an instance map: `hal::Clock.nowMs()` is a namespace mapping in
 * hal's Clock.m.ct onto the `hal_platform_now_ms` symbol defined here
 * (CLOCK_MONOTONIC in milliseconds, anchored at the first call).
 *
 * License: MIT (see LICENSE).
 */
#include <unistd.h>
#include <time.h>

import hal::Uart;
import hal::Gpio;
import hal::Log;

/* The `char *` GPIO entry (`"gpio17".read()`); imported so consumers that
   import PosixHal get both the instance and the device-name spellings. */
import GpioName;

pub struct PosixHal {
    int unused;
}

/* The one instance consumers box: `Uart u = posix_hal;` binds any of the three
   trait maps below, because each map names this same object. */
pub struct PosixHal posix_hal;

/* One bit per pin; the stub covers pins 0..31. */
int hal_posix_gpio_state = 0;

int hal_posix_uart_send(char *buf, int len)
{
    if (len < 0) return -1;
    return (int)write(1, buf, (size_t)len);
}

int hal_posix_uart_recv(char *buf, int len)
{
    if (len < 0) return -1;
    return (int)read(0, buf, (size_t)len);
}

int hal_posix_gpio_read(int pin)
{
    if (pin < 0 || pin >= 32) return -1;
    return (hal_posix_gpio_state >> pin) & 1;
}

int hal_posix_gpio_write(int pin, int value)
{
    if (pin < 0 || pin >= 32) return -1;
    if (value) hal_posix_gpio_state = hal_posix_gpio_state | (1 << pin);
    else hal_posix_gpio_state = hal_posix_gpio_state & ~(1 << pin);
    return 0;
}

/* The symbol behind `hal::Clock.nowMs()`: hal's Clock.m.ct maps its namespace
   method here and ships no body, so this definition is what a program links.
   `nowMs` is anchored at the first call. The contract only promises differences
   (Clock.m.ct: "the origin is unspecified; only differences are meaningful"),
   so returning the time since process start keeps the value inside `int` for
   24.8 days of *runtime*, instead of wrapping when the *machine* has been up
   that long. */
static long hal_posix_t0_ms = -1;

int hal_platform_now_ms(void)
{
    struct timespec ts;
    long ms;

    clock_gettime(CLOCK_MONOTONIC, &ts);
    ms = (long)ts.tv_sec * 1000 + (long)(ts.tv_nsec / 1000000);
    if (hal_posix_t0_ms < 0) hal_posix_t0_ms = ms;
    return (int)(ms - hal_posix_t0_ms);
}

int hal_posix_log_write(char *buf, int len)
{
    if (len < 0) return -1;
    return (int)write(2, buf, (size_t)len);
}

map trait Uart for instance posix_hal {
    send(buf, len) -> hal_posix_uart_send(buf, len);
    recv(buf, len) -> hal_posix_uart_recv(buf, len);
}

map trait Gpio for instance posix_hal {
    read(pin) -> hal_posix_gpio_read(pin);
    write(pin, value) -> hal_posix_gpio_write(pin, value);
}

map trait Log for instance posix_hal {
    write(buf, len) -> hal_posix_log_write(buf, len);
}
